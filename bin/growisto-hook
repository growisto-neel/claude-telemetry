#!/usr/bin/env bash
#
# Single entry point for every Growisto telemetry hook, on every platform.
#
# This script does two things and nothing else: it translates the values Claude
# Code collected at install time into the environment variables the binary
# reads, and it picks the right prebuilt binary for this machine.
#
# There is no interpreter to install. The hook itself is a static Go binary,
# committed to this repo for each platform, because Claude Code bundles no
# runtime -- a Python or Node hook is silently inactive on any machine that
# happens not to have one.
#
# bash is the one thing still assumed, and it is not an extra requirement:
# installing this plugin clones a git repository over your git credentials, so
# anyone who can install it has git, and on Windows Git for Windows brings Git
# Bash with it. Claude Code runs hook commands through Git Bash when it is
# present, which it therefore always is.
#
# Two rules govern everything below:
#
#   1. Exit 0, always. A non-zero exit from a UserPromptSubmit hook can block
#      the prompt. Telemetry must never stand between someone and their work.
#   2. Print nothing on stdout, ever. Whatever a UserPromptSubmit hook prints
#      on stdout is injected into Claude's context, where it would silently
#      corrupt the conversation.

set -u

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="$PLUGIN_ROOT/bin"

BASE_DIR="${GROWISTO_TELEMETRY_DIR:-$HOME/.growisto-claude-telemetry}"
LOG="$BASE_DIR/telemetry.log"

# ---------------------------------------------------------------------------
# userConfig plumbing: deliberately absent
# ---------------------------------------------------------------------------
# This script used to translate the CLAUDE_PLUGIN_OPTION_* variables Claude Code
# sets at install time onto the GROWISTO_TELEMETRY_* names the binary reads. It
# no longer does. The binary reads them itself -- see options.go -- and it does
# the "nowhere to send" diagnostic too.
#
# The reason for moving it is that the shell version needed `compgen` and
# ${!indirect} expansion, which are bash rather than POSIX, and there is no way
# to unit-test a shell script that only ever runs inside a plugin. Two
# implementations of the same fuzzy name matching would have drifted apart, and
# the drift would have been invisible: both failure modes look like "no data".
#
# Nothing needs doing here for those values to arrive. This script does not
# sanitise its environment, so everything Claude Code exported is inherited by
# the binary below.

# ---------------------------------------------------------------------------
# pick the binary for this machine
# ---------------------------------------------------------------------------
# Named for Go's own GOOS/GOARCH so that what is on disk matches what the build
# script produced, with no translation table to drift out of step.
detect_target() {
    local os arch
    case "$(uname -s 2>/dev/null)" in
        Linux)   os=linux ;;
        Darwin)  os=darwin ;;
        # Git Bash reports MINGW64_NT-10.0, MSYS reports MSYS_NT-10.0.
        MINGW*|MSYS*|CYGWIN*) os=windows ;;
        *)       os=unknown ;;
    esac
    case "$(uname -m 2>/dev/null)" in
        x86_64|amd64)  arch=amd64 ;;
        arm64|aarch64) arch=arm64 ;;
        *)             arch=unknown ;;
    esac
    printf '%s-%s' "$os" "$arch"
}

TARGET="$(detect_target)"
HOOK_BIN="$BIN_DIR/growisto-hook-$TARGET"
[ "${TARGET%%-*}" = "windows" ] && HOOK_BIN="$HOOK_BIN.exe"

# An explicit override, for anyone testing a local build without committing it.
if [ -n "${GROWISTO_TELEMETRY_BINARY:-}" ]; then
    HOOK_BIN="$GROWISTO_TELEMETRY_BINARY"
fi

if [ ! -f "$HOOK_BIN" ]; then
    # No binary for this platform. Say so once, in a place someone will find,
    # and then stop complaining -- a warning on every prompt would be worse than
    # the missing telemetry. The marker is what makes it once rather than
    # forever, and it names the target so the fix is obvious: either the build
    # script needs another GOOS/GOARCH pair, or uname said something unexpected.
    marker="$BASE_DIR/NO_BINARY"
    if [ ! -f "$marker" ]; then
        mkdir -p "$BASE_DIR" 2>/dev/null || exit 0
        printf '%s growisto-telemetry: no binary for target %s (uname -s %s, uname -m %s); telemetry is inactive on this machine.\n' \
            "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$TARGET" \
            "$(uname -s 2>/dev/null)" "$(uname -m 2>/dev/null)" \
            >>"$LOG" 2>/dev/null
        : >"$marker" 2>/dev/null
    fi
    exit 0
fi

# A binary arriving later should clear the marker, otherwise the log keeps
# claiming a problem that has been fixed.
rm -f "$BASE_DIR/NO_BINARY" 2>/dev/null

# The executable bit does not survive a git checkout on Windows, and can be
# lost on any platform if the file was committed without mode 100755. Restore it
# rather than failing, because the failure would be silent.
[ -x "$HOOK_BIN" ] || chmod +x "$HOOK_BIN" 2>/dev/null

# ---------------------------------------------------------------------------
# run it
# ---------------------------------------------------------------------------
mkdir -p "$BASE_DIR" 2>/dev/null

if [ "$#" -gt 0 ]; then
    # Invoked by a human -- `growisto-hook --status`, `--test`, `--flush`. Let
    # the output reach the terminal and let the real exit code through, because
    # here the exit code is the answer rather than something that could block
    # somebody's prompt.
    "$HOOK_BIN" "$@"
    exit $?
fi

# Invoked by Claude Code. stdin is the hook payload and passes straight through.
# Both output streams go to the log rather than the terminal: the binary is not
# supposed to print anything at all, but if it ever does, discarding the text
# would make that bug invisible, while letting it reach stdout would feed it
# into Claude's context.
"$HOOK_BIN" >>"$LOG" 2>&1

exit 0
